#!/usr/bin/env python3
"""claude-agents — keep long-lived Claude Code agents running, one per session.

Each agent is an interactive ``claude --remote-control NAME`` session (so
claude.ai and the Claude app can reach it), in its own window of one tmux
server, resumed into the same conversation whenever it starts or restarts,
and optionally listening on channels (``--channels``) — which the
``claude remote-control`` server cannot give its sessions.

An agent is two entries in AGENTS_ROOT, both named by its Claude Code
session ID, which never changes:

    <session-id>.json       its name (kept in step with the session's own
                            name, so a rename anywhere shows up here) and
                            what the supervisor notes: stopped, a fork to
                            start, where it was adopted from
    <session-id>.worktree   where it works: a directory, a git worktree, or a
                            symlink to one anywhere

Its conversation is the session itself: resumed by ID when it exists,
otherwise started with that ID (``--session-id``). A fork gets a new ID and
starts from a copy of its parent's conversation (``--fork-session``), so it
has its own claude.ai session (and, say, its own XMPP address).

Commands take an agent's name, its session ID, or an unambiguous ID prefix::

    claude-agents run                       the supervisor (systemd runs this)
    claude-agents list                      agents, their state and claude.ai links
    claude-agents attach AGENT              its terminal (tmux; detach: C-b d)
    claude-agents new NAME [--dir PATH | --repo PATH]
    claude-agents fork AGENT NAME [--dir PATH]
    claude-agents rename AGENT NAME
    claude-agents restart AGENT             stop it cleanly; the supervisor resumes it
    claude-agents stop AGENT / start AGENT  pause an agent / let it run again
    claude-agents retire AGENT              stop it and move it to AGENTS_ROOT/.retired
    claude-agents revive AGENT              move it back; it resumes its conversation
    claude-agents adopt (--session ID | --dir PATH) [--name NAME] [--move]
                                            take over a session running elsewhere

Settings: ~/.config/claude-agents/config.env (see config.example.env).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time
import uuid
from dataclasses import dataclass, field
from pathlib import Path

SOCKET = os.environ.get("CLAUDE_AGENTS_SOCKET", "claude-agents")  # separate test setups
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._ -]{0,63}$")
SID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
LINK_RE = re.compile(r"https://claude\.ai/code/session_[A-Za-z0-9]+")
QUICK_EXIT_S = 60  # an agent that dies sooner than this counts as failing to start


def _home() -> Path:
    return Path(os.environ.get("HOME", "~")).expanduser()


def claude_home() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR", _home() / ".claude"))


def state_dir() -> Path:
    return Path(os.environ.get("CLAUDE_AGENTS_STATE", _home() / ".local/state/claude-agents"))


def config_path() -> Path:
    return Path(os.environ.get("CLAUDE_AGENTS_CONFIG", _home() / ".config/claude-agents/config.env"))


def log(msg: str) -> None:
    print(f"claude-agents: {msg}", flush=True)


# --- configuration ------------------------------------------------------------


@dataclass
class Config:
    root: Path
    claude: str = "claude"
    channels: list[str] = field(default_factory=list)
    extra_args: list[str] = field(default_factory=list)
    poll: float = 5.0
    session_env: dict[str, str] = field(default_factory=dict)
    alert_cmd: str = ""
    alert_after: float = 60.0
    host: str = ""

    @property
    def plugins(self) -> list[str]:
        """Plugins to enable for agents: those behind ``plugin:NAME@MARKET`` channels."""
        return [c.split(":", 1)[1] for c in self.channels if c.startswith("plugin:")]


def load_config(path: Path | None = None) -> Config:
    """KEY=VALUE lines. AGENTS_* configure this program; everything else is
    passed to each agent's environment (a channel's settings, for instance)."""
    values: dict[str, str] = {}
    path = path or config_path()
    if path.exists():
        for line in path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                value = value[1:-1]
            values[key.strip()] = value
    own = {k: values.pop(k) for k in list(values) if k.startswith("AGENTS_")}
    return Config(
        root=Path(own.get("AGENTS_ROOT", "~/agents")).expanduser(),
        claude=own.get("AGENTS_CLAUDE", "claude"),
        channels=own.get("AGENTS_CHANNELS", "").replace(",", " ").split(),
        extra_args=shlex.split(own.get("AGENTS_CLAUDE_ARGS", "")),
        poll=float(own.get("AGENTS_POLL", "5")),
        session_env=values,
        alert_cmd=own.get("AGENTS_ALERT_CMD", ""),
        alert_after=float(own.get("AGENTS_ALERT_AFTER", "60")),
        host=own.get("AGENTS_HOST", "") or socket.gethostname().split(".")[0],
    )



# --- agents -----------------------------------------------------------------------


@dataclass
class Agent:
    sid: str
    root: Path
    meta: dict

    @property
    def name(self) -> str:
        return self.meta.get("name") or self.sid[:8]

    @property
    def json_path(self) -> Path:
        return self.root / f"{self.sid}.json"

    @property
    def worktree(self) -> Path:
        return self.root / f"{self.sid}.worktree"

    @property
    def real(self) -> Path:
        """The directory Claude Code runs in (symlinks resolved)."""
        return self.worktree.resolve()

    def save(self) -> None:
        tmp = self.root / f".{self.sid}.json.tmp"
        tmp.write_text(json.dumps(self.meta, indent=2) + "\n")
        tmp.replace(self.json_path)

    def update(self, **changes) -> None:
        """Re-read, change, write: the JSON may have been edited meanwhile."""
        self.meta = {**read_json(self.json_path), **changes}
        self.meta = {k: v for k, v in self.meta.items() if v is not None}
        self.save()


def read_json(path: Path) -> dict:
    try:
        d = json.loads(path.read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def list_agents(root: Path) -> list[Agent]:
    """Every <sid>.json in ``root`` whose <sid>.worktree is a directory."""
    agents = []
    if not root.is_dir():
        return agents
    for j in sorted(root.glob("*.json")):
        sid = j.stem
        if SID_RE.match(sid) and (root / f"{sid}.worktree").is_dir():
            agents.append(Agent(sid, root, read_json(j)))
    return sorted(agents, key=lambda a: a.name.lower())


def slug(path: Path | str) -> str:
    """How Claude Code names a directory's folder under ~/.claude/projects."""
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def project_dir(real: Path) -> Path:
    return claude_home() / "projects" / slug(real)


def has_transcript(real: Path, session: str | None) -> bool:
    return bool(session) and (project_dir(real) / f"{session}.jsonl").is_file()


def newest_session(real: Path) -> str | None:
    files = sorted(project_dir(real).glob("*.jsonl"), key=lambda p: p.stat().st_mtime)
    return files[-1].stem if files else None


def session_title(real: Path, session: str) -> str | None:
    """The session's current name, as its conversation records it: Claude Code
    appends a ``custom-title`` entry for every naming and rename."""
    title = None
    try:
        with (project_dir(real) / f"{session}.jsonl").open() as f:
            for line in f:
                if '"custom-title"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("type") == "custom-title" and d.get("customTitle"):
                    title = d["customTitle"]
    except OSError:
        pass
    return title


def remote_link(real: Path, session: str) -> str | None:
    """The claude.ai link for the session's Remote Control session: its
    conversation records it as a ``bridge-session`` entry (cse_X is
    claude.ai/code/session_X). Reading the terminal instead fails once the
    startup banner has been redrawn away."""
    bridge = None
    try:
        with (project_dir(real) / f"{session}.jsonl").open() as f:
            for line in f:
                if '"bridge-session"' in line:
                    try:
                        bridge = json.loads(line).get("bridgeSessionId") or bridge
                    except ValueError:
                        pass
    except OSError:
        pass
    if bridge and bridge.startswith("cse_"):
        return f"https://claude.ai/code/session_{bridge[4:]}"
    return None


def claude_args(agent: Agent, cfg: Config) -> list[str]:
    name = agent.name
    # --name every time: the JSON follows the live session's name (which is
    # where renames made in the app show up; they are not recorded in the
    # conversation), and it applies one made with `rename` while stopped.
    args = [cfg.claude, "--remote-control", name, "--name", name]
    if cfg.channels:
        args += ["--channels", *cfg.channels]
    if cfg.plugins:
        # Enabled for agents only, not for every Claude session on the machine.
        args += ["--settings", json.dumps({"enabledPlugins": {p: True for p in cfg.plugins}})]
    if has_transcript(agent.real, agent.sid):
        args += ["--resume", agent.sid]
    elif agent.meta.get("fork_from"):
        args += ["--resume", agent.meta["fork_from"], "--fork-session", "--session-id", agent.sid]
    else:
        args += ["--session-id", agent.sid]
    return args + cfg.extra_args


def live_session(pid: int) -> dict:
    """What Claude Code (running as ``pid``) says about its session."""
    return read_json(claude_home() / "sessions" / f"{pid}.json")


def resolve(cfg: Config, key: str, agents: list[Agent] | None = None) -> Agent:
    """An agent by session ID, ID prefix (4+ characters) or current name."""
    agents = list_agents(cfg.root) if agents is None else agents
    exact = [a for a in agents if a.sid == key]
    by_prefix = [a for a in agents if len(key) >= 4 and a.sid.startswith(key.lower())]
    by_name = [a for a in agents if a.name.casefold() == key.casefold()]
    for found in (exact, by_name, by_prefix):
        if len(found) == 1:
            return found[0]
        if len(found) > 1:
            sys.exit(f"claude-agents: {key!r} is ambiguous: "
                     + ", ".join(f"{a.name} ({a.sid})" for a in found))
    sys.exit(f"claude-agents: no agent {key!r} in {cfg.root} (see `claude-agents list`)")


def create(cfg: Config, name: str, *, dir: str | None = None, repo: str | None = None,
           sid: str | None = None, **meta) -> Agent:
    """Make a new agent's two entries (its conversation starts on first run)."""
    if not NAME_RE.match(name):
        sys.exit(f"claude-agents: {name!r} is not a usable name")
    if any(a.name.casefold() == name.casefold() for a in list_agents(cfg.root)):
        sys.exit(f"claude-agents: there is already an agent called {name!r}")
    cfg.root.mkdir(parents=True, exist_ok=True)
    agent = Agent(sid or str(uuid.uuid4()), cfg.root, {"name": name, **meta})
    wt = agent.worktree
    if dir:
        real = Path(dir).expanduser().resolve()
        if not real.is_dir():
            sys.exit(f"claude-agents: {real} is not a directory")
        wt.symlink_to(real)
    elif repo:
        branch = re.sub(r"[^A-Za-z0-9._-]", "-", name)
        r = subprocess.run(["git", "-C", str(Path(repo).expanduser()), "worktree", "add",
                            "-b", branch, str(wt)], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"claude-agents: git worktree add failed: {r.stderr.strip()}")
    else:
        wt.mkdir()
    # The JSON last: it is what makes the pair an agent.
    agent.save()
    return agent


# --- converting the old layout (a directory named after the agent) ------------------


def legacy_entries(root: Path) -> list[Path]:
    if not root.is_dir():
        return []
    return [e for e in sorted(root.iterdir())
            if not e.name.startswith(".") and e.suffix not in (".json", ".worktree")
            and not e.name.endswith(".json.tmp") and e.is_dir()]


class NotLegacy(Exception):
    """An entry that looks like the old layout but must not be converted."""


def convert_legacy(cfg: Config, entry: Path) -> None:
    """``root/NAME`` (the old layout) -> ``root/<sid>.json`` + ``root/<sid>.worktree``.

    Everything is checked before anything is touched: an entry whose session
    already is an agent here (a leftover, or a directory something else
    recreated at the old path) is left alone, as is one with no conversation
    of its own.
    """
    name = entry.name
    real = entry.resolve()
    old_state = read_json(state_dir() / "agents" / f"{name}.json")
    sid = old_state.get("session") if has_transcript(real, old_state.get("session")) else None
    sid = sid or newest_session(real)
    if not sid:
        raise NotLegacy("no conversation of its own; not an agent (see `claude-agents new`)")
    if (cfg.root / f"{sid}.json").exists() or (cfg.root / f"{sid}.worktree").exists():
        raise NotLegacy(f"its session {sid} is already an agent here; leaving it alone")
    if entry.stat().st_uid != os.getuid():
        raise NotLegacy("not owned by this user; not an agent")
    p = pane(name)  # the old layout's tmux session was named after the agent
    live = live_session(p.pid) if p and not p.dead else {}
    stop(name)
    wt = cfg.root / f"{sid}.worktree"
    if entry.is_symlink():
        entry.rename(wt)  # the target, and so the conversation's folder, stay put
    else:
        if has_transcript(real, sid):
            _copy_conversation(sid, real, wt)  # filed under the new path first
        _relocate(entry, wt)
    # Its name is the session's, not the old directory's: live if it was
    # running, else as the conversation last recorded it.
    title = (live.get("name") if live.get("sessionId") == sid else None) or session_title(real, sid)
    meta = {"name": title or name}
    for k in ("adopted_from", "stopped"):
        if old_state.get(k):
            meta[k] = old_state[k]
    Agent(sid, cfg.root, meta).save()
    (state_dir() / "agents" / f"{name}.json").unlink(missing_ok=True)
    log(f"{name}: converted to {sid}.json + {sid}.worktree")


# --- tmux ---------------------------------------------------------------------------


def tmux(*args: str) -> subprocess.CompletedProcess:
    conf = state_dir() / "tmux.conf"
    return subprocess.run(["tmux", "-L", SOCKET, "-f", str(conf), *args],
                          capture_output=True, text=True)


def write_tmux_conf() -> None:
    state_dir().mkdir(parents=True, exist_ok=True)
    (state_dir() / "tmux.conf").write_text(
        "# Written by claude-agents.\n"
        "set -g remain-on-exit on\n"      # keep a dead pane, so its exit is seen
        "set -g history-limit 50000\n"
        # Each window is named after its agent (sessions stay keyed by
        # session ID), so C-b s / C-b w list agents by name. Nothing the
        # program in the pane does may rename it.
        "set -g automatic-rename off\n"
        "set -g allow-rename off\n"
    )


@dataclass
class Pane:
    dead: bool
    pid: int
    status: str


def pane(name: str) -> Pane | None:
    r = tmux("list-panes", "-t", f"={name}:", "-F",
             "#{pane_dead} #{pane_pid} #{pane_dead_status}:#{pane_dead_signal}")
    if r.returncode != 0 or not r.stdout.strip():
        return None
    dead, pid, how = (r.stdout.split() + ["", "", ":"])[:3]
    status, _, sig = how.partition(":")
    return Pane(dead == "1", int(pid), f"signal {sig}" if sig else f"status {status or '?'}")


def tmux_sessions() -> set[str]:
    r = tmux("list-sessions", "-F", "#{session_name}")
    return set(r.stdout.split()) if r.returncode == 0 else set()



def stop(*names: str, wait: float = 20.0) -> None:
    """Claude Code's own clean exit (Ctrl-C twice) for each, together; then
    remove their tmux sessions."""
    running = [n for n in names if (p := pane(n)) and not p.dead]
    for key_press in (1, 2):
        for n in running:
            tmux("send-keys", "-t", f"={n}:", "C-c")
        time.sleep(1)
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline and any((p := pane(n)) and not p.dead for n in running):
        time.sleep(0.5)
    for n in names:
        tmux("kill-session", "-t", f"={n}")




def start(agent: Agent, cfg: Config) -> None:
    """Start (or restart) the agent in its tmux session, named by its session ID."""
    env = [x for k, v in cfg.session_env.items() for x in ("-e", f"{k}={v}")]
    args = claude_args(agent, cfg)
    if pane(agent.sid) is not None:
        r = tmux("respawn-pane", "-k", "-t", f"={agent.sid}:", "-c", str(agent.real), *env, *args)
    else:
        r = tmux("new-session", "-d", "-s", agent.sid, "-n", agent.name, "-x", "220", "-y", "50",
                 "-c", str(agent.real), *env, *args)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"tmux exited {r.returncode}")
    how = ("resuming" if "--fork-session" not in args and "--resume" in args
           else "forking " + agent.meta["fork_from"] if "--fork-session" in args
           else "new conversation")
    log(f"{agent.name} ({agent.sid}): started in {agent.real} ({how})")


# --- waiting at a prompt ------------------------------------------------------------

# A dialog waiting for someone at the terminal: a numbered choice with the
# cursor on it, and the footer every one of Claude Code's dialogs has. Remote
# Control does not pass every dialog on to the app (auto mode's "N consecutive
# actions were blocked" confirmation, for one), so an unattended agent can sit
# at one for hours with nothing to show for it anywhere but its terminal.
_CHOICE = re.compile(r"^\s*[❯>]\s*1\.\s")
_FOOTER = "Esc to cancel"
_RULE = re.compile(r"^\s*[─━]{10,}")


def screen(name: str) -> str | None:
    """The visible text of the agent's terminal, or None."""
    r = tmux("capture-pane", "-p", "-t", f"={name}:")
    return r.stdout if r.returncode == 0 else None


def waiting_prompt(text: str | None) -> str | None:
    """What a dialog at the bottom of the screen asks, or None if there is none.

    The dialog is the block below the last horizontal rule, up to the footer;
    box-drawing and blank lines are dropped and the rest joined, so the text
    names the tool, the command and, for auto mode, the reason it stopped.
    """
    if not text:
        return None
    lines = text.rstrip().splitlines()[-40:]
    footer = next((i for i in range(len(lines) - 1, -1, -1) if _FOOTER in lines[i]), None)
    if footer is None or not any(_CHOICE.match(line) for line in lines[:footer]):
        return None
    top = max((i for i in range(footer) if _RULE.match(lines[i])), default=-1) + 1
    body = []
    for line in lines[top:footer]:
        line = line.strip().strip("│╭╮╰╯").strip()
        if line and not _CHOICE.match(line) and not re.match(r"^\d+\.\s", line):
            body.append(line)
    summary = " ".join(" ".join(body).split())
    return summary[:600] or "a dialog"


@dataclass
class Waiting:
    since: float
    what: str
    alerted: bool = False
    retry_at: float = 0.0


def send_alert(cfg: Config, agent: Agent, event: str, text: str) -> bool:
    """Run AGENTS_ALERT_CMD with the text on stdin. True if it succeeded."""
    env = dict(os.environ, ALERT_EVENT=event, ALERT_AGENT=agent.name,
               ALERT_SESSION=agent.sid, ALERT_HOST=cfg.host)
    try:
        r = subprocess.run(["sh", "-c", cfg.alert_cmd], input=text, text=True, env=env,
                           capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"{agent.name}: alert command failed: {exc}")
        return False
    if r.returncode != 0:
        log(f"{agent.name}: alert command exited {r.returncode}: "
            f"{(r.stderr or r.stdout).strip()[:200]}")
        return False
    return True


# --- the supervisor -----------------------------------------------------------------


class Supervisor:
    def __init__(self, cfg: Config) -> None:
        self.cfg = cfg
        self.started_at: dict[str, float] = {}
        self.not_before: dict[str, float] = {}
        self.failures: dict[str, int] = {}
        self.reported: set[str] = set()
        self.waiting: dict[str, Waiting] = {}
        self.window_names: dict[str, str] = {}
        self.stopping = False

    def tick(self) -> None:
        for entry in legacy_entries(self.cfg.root):
            try:
                convert_legacy(self.cfg, entry)
            except (NotLegacy, OSError, RuntimeError, SystemExit) as exc:
                if entry.name not in self.reported:  # once, not every tick
                    self.reported.add(entry.name)
                    log(f"{entry.name}: not converted: {exc}")
        agents = {a.sid: a for a in list_agents(self.cfg.root)}
        gone = tmux_sessions() - set(agents)
        if gone:
            log(f"{', '.join(sorted(gone))}: no longer an agent; stopping")
            stop(*gone)
        now = time.monotonic()
        for sid in list(self.waiting):
            if sid not in agents:
                self.waiting.pop(sid)
        for sid, agent in agents.items():
            p = pane(sid)
            if self.cfg.alert_cmd:
                live = p is not None and not p.dead and not agent.meta.get("stopped")
                self._watch(agent, waiting_prompt(screen(sid)) if live else None, now)
            if agent.meta.get("stopped"):
                if p:
                    log(f"{agent.name}: stopped by request")
                    stop(sid)
                continue
            if p and not p.dead:
                self._follow(agent, p)
                continue
            if p and p.dead and sid in self.started_at:
                quick = now - self.started_at.pop(sid) < QUICK_EXIT_S
                self.failures[sid] = self.failures.get(sid, 0) + 1 if quick else 0
                delay = min(300.0, 10.0 * 2 ** (self.failures[sid] - 1)) if quick else 5.0
                self.not_before[sid] = now + delay
                log(f"{agent.name}: exited ({p.status}); restarting in {delay:.0f}s")
            if now < self.not_before.get(sid, 0):
                continue
            try:
                start(agent, self.cfg)
                self.started_at[sid] = now
            except (RuntimeError, OSError) as exc:
                log(f"{agent.name}: could not start: {exc}")
                self.not_before[sid] = now + 60

    def _watch(self, agent: Agent, what: str | None, now: float) -> None:
        """Alert once when the agent has sat at a dialog for AGENTS_ALERT_AFTER
        seconds, and once more when it is gone. A different dialog is a new wait."""
        w = self.waiting.get(agent.sid)
        if w and w.what != what:
            if w.alerted:
                gone = "a different one" if what else "answered, or gone"
                send_alert(self.cfg, agent, "cleared",
                           f"{agent.name} on {self.cfg.host} is no longer waiting "
                           f"({gone}, after {_minutes(now - w.since)}).")
            self.waiting.pop(agent.sid)
            w = None
        if what is None:
            return
        if w is None:
            w = self.waiting[agent.sid] = Waiting(since=now, what=what)
        if w.alerted or now - w.since < self.cfg.alert_after or now < w.retry_at:
            return
        text = (f"{agent.name} on {self.cfg.host} has been waiting at a prompt for "
                f"{_minutes(now - w.since)}: {what}\n"
                f"Answer it at the terminal: claude-agents attach {agent.name}")
        if send_alert(self.cfg, agent, "waiting", text):
            w.alerted = True
            log(f"{agent.name}: waiting at a prompt; alert sent")
        else:
            w.retry_at = now + 300

    def _name_window(self, agent: Agent) -> None:
        """The tmux window shows the agent's current name (the session stays
        keyed by session ID). Only asks tmux when the name has changed."""
        if self.window_names.get(agent.sid) == agent.name:
            return
        if tmux("rename-window", "-t", f"={agent.sid}:", agent.name).returncode == 0:
            self.window_names[agent.sid] = agent.name

    def _follow(self, agent: Agent, p: Pane) -> None:
        """Keep the JSON in step with the running session: its name, and once
        a fork's own conversation exists, forget the parent."""
        self._name_window(agent)
        live = live_session(p.pid)
        if live.get("sessionId") != agent.sid:
            return
        name = live.get("name")
        if name and name != agent.meta.get("name"):
            log(f"{agent.name}: renamed to {name}")
            agent.update(name=name)
            self._name_window(agent)
        if agent.meta.get("fork_from") and has_transcript(agent.real, agent.sid):
            agent.update(fork_from=None)

    def run(self) -> None:
        write_tmux_conf()
        self.cfg.root.mkdir(parents=True, exist_ok=True)
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, lambda *_: setattr(self, "stopping", True))
        log(f"supervising {self.cfg.root}")
        while not self.stopping:
            try:
                self.tick()
            except Exception as exc:  # noqa: BLE001 - keep supervising
                log(f"tick failed: {exc!r}")
            end = time.monotonic() + self.cfg.poll
            while not self.stopping and time.monotonic() < end:
                time.sleep(0.2)
        log("stopping every agent")
        stop(*tmux_sessions())
        tmux("kill-server")



def _minutes(seconds: float) -> str:
    m = int(seconds // 60)
    return f"{m} min" if m else f"{int(seconds)} s"


# --- adopting a session that runs elsewhere, and moving agents ------------------------


def _alive(pid: int) -> bool:
    """Running, as opposed to gone or a zombie waiting to be reaped."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0] != "Z"
    except (OSError, IndexError):
        return True


def _cwd_of_transcript(path: Path) -> Path | None:
    """The directory a conversation ran in, from its records."""
    try:
        with path.open() as f:
            for line in f:
                try:
                    cwd = json.loads(line).get("cwd")
                except ValueError:
                    continue
                if cwd:
                    return Path(cwd)
    except OSError:
        pass
    return None


def find_session(session: str) -> tuple[list[int], Path | None]:
    """Processes running ``session`` now, and the directory it runs (or ran) in."""
    pids, cwd = [], None
    for f in (claude_home() / "sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if d.get("sessionId") == session and _alive(int(d.get("pid", 0))):
            pids.append(int(d["pid"]))
            cwd = Path(d["cwd"]) if d.get("cwd") else cwd
    if cwd is None:
        for t in (claude_home() / "projects").glob(f"*/{session}.jsonl"):
            cwd = _cwd_of_transcript(t)
            if cwd:
                break
    return pids, cwd


def session_in(real: Path) -> tuple[str | None, list[int]]:
    """The session running in ``real``, else the newest conversation there."""
    for f in (claude_home() / "sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if d.get("cwd") and Path(d["cwd"]).resolve() == real and _alive(int(d.get("pid", 0))):
            return d["sessionId"], [int(d["pid"])]
    return newest_session(real), []


def _ancestors() -> set[int]:
    pids, pid = set(), os.getpid()
    while pid > 1:
        pids.add(pid)
        try:
            pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return pids


def _detach(log_path: Path) -> None:
    """Carry on in the background, outliving the session that ran us."""
    log_path.parent.mkdir(parents=True, exist_ok=True)
    if os.fork():
        os._exit(0)
    os.setsid()
    if os.fork():
        os._exit(0)
    out = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    null = os.open(os.devnull, os.O_RDONLY)
    os.dup2(null, 0)
    os.dup2(out, 1)
    os.dup2(out, 2)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)


def _stop_process(pid: int, wait: float = 30.0) -> None:
    log(f"stopping process {pid}")
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline and _alive(pid):
        time.sleep(0.5)
    if _alive(pid):
        log(f"process {pid} still running; SIGKILL")
        os.kill(pid, signal.SIGKILL)
        time.sleep(1)


def _copy_conversation(session: str, src_dir: Path, dst_dir: Path,
                       replace_older: bool = False) -> None:
    """File a copy of ``session``'s conversation under ``dst_dir``.

    Never overwrites a conversation that is as new as, or newer than, the one
    being copied: that could be a live session's, and overwriting it loses
    everything said since. An older copy there is replaced only with
    ``replace_older`` (moving an agent's own conversation back and forth);
    otherwise it is an error.
    """
    src, dst = project_dir(src_dir.resolve()), project_dir(dst_dir.resolve())
    s_file, d_file = src / f"{session}.jsonl", dst / f"{session}.jsonl"
    if d_file.exists():
        if d_file.stat().st_mtime >= s_file.stat().st_mtime:
            return  # already there, and at least as new: keep it
        if not replace_older:
            raise RuntimeError(f"{d_file} already holds a conversation; not overwriting it")
    dst.mkdir(parents=True, exist_ok=True)
    shutil.copy2(s_file, d_file)
    if (src / session).is_dir():
        shutil.copytree(src / session, dst / session, dirs_exist_ok=True)


def _move_problem(src: Path, root: Path) -> str | None:
    """Why ``src`` can't be moved into ``root``, checked before anything is stopped."""
    if (src / ".git").is_dir():
        return f"{src} is a repository's main checkout; adopt it without --move"
    root.mkdir(parents=True, exist_ok=True)
    if src.stat().st_dev != root.stat().st_dev:
        return (f"{src} and {root} are on different filesystems, which git worktree move "
                f"cannot cross; adopt it without --move, or keep AGENTS_ROOT on the same one")
    return None


def _worktree_repo(src: Path) -> str | None:
    if not (src / ".git").is_file():
        return None
    common = subprocess.run(["git", "-C", str(src), "rev-parse", "--path-format=absolute",
                             "--git-common-dir"], capture_output=True, text=True).stdout.strip()
    return str(Path(common).parent)


def _is_locked(repo: str, src: Path) -> bool:
    out = subprocess.run(["git", "-C", repo, "worktree", "list", "--porcelain"],
                         capture_output=True, text=True).stdout
    for block in out.split("\n\n"):
        lines = block.splitlines()
        if lines and Path(lines[0].removeprefix("worktree ")).resolve() == src.resolve():
            return any(line == "locked" or line.startswith("locked ") for line in lines)
    return False


def _relocate(src: Path, dst: Path) -> None:
    """Move an adopted directory into AGENTS_ROOT (a worktree, via git)."""
    repo = _worktree_repo(src)
    if repo is None:
        src.rename(dst)
        return
    # The Remote Control server locks the worktrees it creates.
    locked = _is_locked(repo, src)
    if locked:
        subprocess.run(["git", "-C", repo, "worktree", "unlock", str(src)], capture_output=True)
    r = subprocess.run(["git", "-C", repo, "worktree", "move", str(src), str(dst)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        if locked:
            subprocess.run(["git", "-C", repo, "worktree", "lock", str(src)], capture_output=True)
        raise RuntimeError(f"git worktree move failed: {r.stderr.strip()}")



# --- commands -------------------------------------------------------------------------


def cmd_list(cfg: Config, _args) -> None:
    agents = list_agents(cfg.root)
    if not agents:
        print(f"No agents in {cfg.root}.")
        return
    for a in agents:
        p = pane(a.sid)
        status = "not running" if p is None else ("exited" if p.dead else "running")
        if a.meta.get("stopped"):
            status = "stopped"
        link = remote_link(a.real, a.sid) or ""
        if not link and p:
            links = LINK_RE.findall(tmux("capture-pane", "-p", "-S", "-",
                                         "-t", f"={a.sid}:").stdout)
            link = links[-1] if links else ""
        where = f"{a.worktree} -> {a.real}" if a.worktree.is_symlink() else str(a.real)
        print(f"{a.name:20} {status:12} {a.sid}  {link}\n{'':20} {where}")


def cmd_attach(cfg: Config, args) -> None:
    a = resolve(cfg, args.agent)
    os.execvp("tmux", ["tmux", "-L", SOCKET, "attach", "-t", f"={a.sid}"])


def cmd_new(cfg: Config, args) -> None:
    a = create(cfg, args.name, dir=args.dir, repo=args.repo)
    print(f"Added {a.name} ({a.sid}); the supervisor starts it within {cfg.poll:.0f}s.")


def _git_toplevel(path: Path) -> str | None:
    r = subprocess.run(["git", "-C", str(path), "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def cmd_fork(cfg: Config, args) -> None:
    """A new agent that starts from a copy of PARENT's conversation."""
    parent = resolve(cfg, args.agent)
    if not has_transcript(parent.real, parent.sid):
        sys.exit(f"claude-agents: {parent.name} has no conversation to fork yet")
    repo = _git_toplevel(parent.real) if args.dir is None else None
    child = create(cfg, args.name, dir=args.dir, repo=repo, sid=str(uuid.uuid4()),
                   fork_from=parent.sid, forked_from=parent.name)
    # --resume finds conversations by directory: file a copy (a snapshot; the
    # parent carries on) under the child's.
    _copy_conversation(parent.sid, parent.real, child.real)
    print(f"Forked {parent.name} into {child.name} ({child.sid}); the supervisor starts it "
          f"within {cfg.poll:.0f}s, from a copy of {parent.name}'s conversation.")


def cmd_rename(cfg: Config, args) -> None:
    a = resolve(cfg, args.agent)
    if not NAME_RE.match(args.name):
        sys.exit(f"claude-agents: {args.name!r} is not a usable name")
    p = pane(a.sid)
    if p and not p.dead:
        # The session's own rename: every place that shows its name follows,
        # and the supervisor picks it up from the session within a poll.
        tmux("send-keys", "-t", f"={a.sid}:", "-l", f"/rename {args.name}")
        tmux("send-keys", "-t", f"={a.sid}:", "Enter")
        print(f"Renaming {a.name} to {args.name} in its session.")
    else:
        a.update(name=args.name)
        print(f"Renamed {a.name} to {args.name}; its session takes the name when it next starts.")


def cmd_stop(cfg: Config, args) -> None:
    a = resolve(cfg, args.agent)
    a.update(stopped=True)
    stop(a.sid)
    print(f"Stopped {a.name}; it stays stopped until `claude-agents start {a.name}`.")


def cmd_start(cfg: Config, args) -> None:
    a = resolve(cfg, args.agent)
    a.update(stopped=None)
    print(f"{a.name} will be started within {cfg.poll:.0f}s, resuming its conversation.")


def cmd_restart(cfg: Config, args) -> None:
    a = resolve(cfg, args.agent)
    stop(a.sid)
    print(f"Stopped {a.name}; the supervisor resumes it within {cfg.poll:.0f}s.")


def cmd_retire(cfg: Config, args) -> None:
    """Stop the agent and move its entries aside. Nothing is deleted: its files
    and conversation stay, and ``revive`` brings it back where it was."""
    a = resolve(cfg, args.agent)
    retired = cfg.root / ".retired"
    retired.mkdir(exist_ok=True)
    a.update(stopped=True)
    stop(a.sid)
    wt = a.worktree
    if wt.is_symlink():
        wt.rename(retired / wt.name)
    else:
        if has_transcript(a.real, a.sid):
            _copy_conversation(a.sid, a.real, retired / wt.name, replace_older=True)
        _relocate(wt, retired / wt.name)
    a.json_path.rename(retired / a.json_path.name)
    print(f"Retired {a.name} to {retired}.")


def cmd_revive(cfg: Config, args) -> None:
    retired = cfg.root / ".retired"
    candidates = [Agent(j.stem, retired, read_json(j)) for j in retired.glob("*.json")
                  if SID_RE.match(j.stem)] if retired.is_dir() else []
    a = resolve(cfg, args.agent, candidates)
    wt = a.worktree
    if wt.is_symlink():
        wt.rename(cfg.root / wt.name)
    else:
        if has_transcript(a.real, a.sid):
            _copy_conversation(a.sid, a.real, cfg.root / wt.name, replace_older=True)
        _relocate(wt, cfg.root / wt.name)
    a.json_path.rename(cfg.root / a.json_path.name)
    Agent(a.sid, cfg.root, read_json(cfg.root / a.json_path.name)).update(stopped=None)
    print(f"Revived {a.name}; it resumes its conversation within {cfg.poll:.0f}s.")


def cmd_adopt(cfg: Config, args) -> None:
    if args.session:
        session = args.session
        pids, cwd = find_session(session)
        if cwd is None:
            sys.exit(f"claude-agents: no session {session} found")
        real = cwd.resolve()
    else:
        real = Path(args.dir).expanduser().resolve()
        session, pids = session_in(real)
        if not session:
            sys.exit(f"claude-agents: no conversation found in {real}")
    if not has_transcript(real, session):
        sys.exit(f"claude-agents: session {session} has no conversation under {real}")
    if any(a.sid == session for a in list_agents(cfg.root)):
        sys.exit(f"claude-agents: session {session} is already an agent here")
    root = cfg.root.resolve()
    if real == root or root in real.parents:
        sys.exit(f"claude-agents: {real} is already under {cfg.root}")
    name = args.name
    if not name:
        live = [live_session(p) for p in pids]
        name = next((s.get("name") for s in live if s.get("name")), None) or real.name
    if not NAME_RE.match(name):
        sys.exit(f"claude-agents: {name!r} is not a usable name; pass --name")
    if any(a.name.casefold() == name.casefold() for a in list_agents(cfg.root)):
        sys.exit(f"claude-agents: there is already an agent called {name!r}; pass --name")
    if args.move and (problem := _move_problem(real, cfg.root)):
        sys.exit(f"claude-agents: {problem}")
    agent = Agent(session, cfg.root, {"name": name, "adopted_from": str(real)})
    print(f"Adopting session {session} from {real} as {name}"
          + (f", moving it to {agent.worktree}" if args.move
             else f" ({agent.worktree} -> {real})")
          + (f"; stopping process {', '.join(map(str, pids))}" if pids else "") + ".")

    adopting_self = bool(set(pids) & _ancestors())
    if args.dry_run:
        print("Dry run: checks passed; nothing done."
              + (" This is the session being adopted: it would carry on in the background."
                 if adopting_self else ""))
        return
    if adopting_self:
        # We are running inside the session we adopt: stopping it would stop us.
        log_path = state_dir() / f"adopt-{session}.log"
        print(f"This is the session being adopted: carrying on in the background in "
              f"{args.grace:.0f}s, once this reply has finished. Log: {log_path}", flush=True)
        _detach(log_path)
        time.sleep(args.grace)
    for pid in pids:
        _stop_process(pid)
    if any(_alive(p) for p in pids):
        sys.exit("claude-agents: the session is still running; not adopting it")

    # The conversation is in place before the entries appear, and the JSON
    # comes last, so the supervisor never starts the agent without it.
    try:
        if args.move:
            _copy_conversation(session, real, agent.worktree)
            _relocate(real, agent.worktree)
        else:
            agent.worktree.symlink_to(real)
        agent.save()
    except (OSError, RuntimeError) as exc:
        if args.move:
            copied = project_dir(agent.worktree)
            (copied / f"{session}.jsonl").unlink(missing_ok=True)
            shutil.rmtree(copied / session, ignore_errors=True)
        if agent.worktree.is_symlink():
            agent.worktree.unlink()
        sys.exit(f"claude-agents: could not adopt it: {exc}. Nothing was adopted; "
                 f"the session is stopped and can be resumed where it was.")
    log(f"adopted {session} as {name}")
    deadline = time.monotonic() + args.wait
    while time.monotonic() < deadline:
        p = pane(session)
        if p and not p.dead and live_session(p.pid).get("sessionId") == session:
            log(f"{name} is running under the supervisor, resuming {session}")
            return
        time.sleep(2)
    if args.wait:
        log(f"{name}: not seen running yet; check `claude-agents list` and the supervisor's log")


def main(argv: list[str] | None = None) -> None:
    ap = argparse.ArgumentParser(prog="claude-agents", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("run")
    sub.add_parser("list")
    for name in ("attach", "restart", "stop", "start", "retire", "revive"):
        sub.add_parser(name).add_argument("agent")
    p = sub.add_parser("new")
    p.add_argument("name")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--dir", help="work in this directory (a symlink to it)")
    g.add_argument("--repo", help="work in a new git worktree of this repository")
    p = sub.add_parser("fork")
    p.add_argument("agent")
    p.add_argument("name")
    p.add_argument("--dir")
    p = sub.add_parser("rename")
    p.add_argument("agent")
    p.add_argument("name")
    p = sub.add_parser("adopt")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--session")
    g.add_argument("--dir")
    p.add_argument("--name", help="default: the session's own name")
    p.add_argument("--move", action="store_true")
    p.add_argument("--dry-run", action="store_true", help="check and show the plan; change nothing")
    p.add_argument("--grace", type=float, default=10.0,
                   help="seconds to wait before stopping, when adopting the session running us")
    p.add_argument("--wait", type=float, default=60.0,
                   help="seconds to wait for the supervisor to start it (0: don't)")
    args = ap.parse_args(argv)
    cfg = load_config()
    if args.cmd == "run":
        Supervisor(cfg).run()
    else:
        {"list": cmd_list, "attach": cmd_attach, "new": cmd_new, "fork": cmd_fork,
         "rename": cmd_rename, "restart": cmd_restart, "stop": cmd_stop, "start": cmd_start,
         "retire": cmd_retire, "revive": cmd_revive, "adopt": cmd_adopt}[args.cmd](cfg, args)


if __name__ == "__main__":
    main()
