# ~/.config/claude-agents/config.env — for the whole host, not per agent.

# Every directory (or symlink to one) at the top of AGENTS_ROOT is an agent,
# named after it. Keep it for agents only: anything a tool creates there comes
# to life as an agent. Trust it once — run `claude` in it and accept the
# workspace-trust prompt — and directories created inside it are trusted too.
AGENTS_ROOT=~/agents

# Channels every agent listens on (space- or comma-separated), as for
# `claude --channels`. Unattended agents need channels on the approved list:
# plugins named in allowedChannelPlugins in managed settings. Plugins named
# here are enabled for the agents only. Empty: no channels.
AGENTS_CHANNELS=

# Extra arguments for every agent's `claude`, and how often to look (seconds).
#AGENTS_CLAUDE_ARGS=--model opus
#AGENTS_POLL=5

# Everything else is put in each agent's environment — typically a channel's
# own settings. For example, the xmpp-mcp channel
# (https://github.com/abligh/xmpp-mcp):
#AGENTS_CHANNELS=plugin:xmpp@xmpp-mcp
#XMPP_JID={session}.{host}@agents.example.com
#XMPP_AGENT_HOST=host1
#XMPP_HOST_KEY_FILE=/home/claude/.config/xmpp-mcp/host1.key
#XMPP_CHANNEL_ALLOW=*@agents.example.com,*@example.com
#XMPP_AUTO_JOIN=agents@conference.example.com
